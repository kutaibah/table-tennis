# Copy to .env.local and fill in values.

MONGODB_URI=mongodb://127.0.0.1:27017/table-tennis

# At least 32 random characters (used to sign session JWTs). Example:
# openssl rand -base64 32
AUTH_SECRET=

# After the first admin exists, set to "true" to allow additional registrations via /register.
ALLOW_ADMIN_REGISTER=
